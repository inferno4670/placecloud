# Copy this to .env and fill in values for local development
DATABASE_URL=sqlite:///./placecloud.db
SECRET_KEY=placecloud-super-secret-key-change-in-production
UPLOAD_DIR=./uploads

# For production PostgreSQL (Railway provides this automatically):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS — set to your Railway frontend URL after deployment:
# FRONTEND_URL=https://placecloud-frontend.up.railway.app
